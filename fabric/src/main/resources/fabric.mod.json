	"authors": [
		"aruma256",
		"LOTqwerty"
	],
	"contact": {
		"sources": "https://github.com/aruma256/PocketPalette"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/pocketpalette/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.github.aruma256.pocketpalette.fabric.PocketPaletteFabricClient"
		]
